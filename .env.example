# Shared settings for ./mvnw spring-boot:run and docker compose.

# Required by both run paths. Use a local-only password.
DATABASE_PASSWORD=choose-a-local-password

# Used by the production image in compose.yaml. Use the tag built locally or
# the full main commit published to GHCR.
APP_VERSION=local

# Host CPU architecture for the Linux image. Only amd64 or arm64 is accepted.
ARCH=amd64

# Public HTTPS origin without a path, used for canonical links and image URLs.
PUBLIC_ORIGIN=https://localhost
# Name shown in page and sharing metadata.
SITE_NAME=Swedish Polls

# Local ports. Maven uses both values; Compose uses APP_PORT for the app and
# DATABASE_PORT for the development PostgreSQL service.
APP_PORT=8080
DATABASE_PORT=5432
