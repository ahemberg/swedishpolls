{
  "version": "v1",
  "basePath": "/api/v1",
  "frozenBy": "https://github.com/ahemberg/swedishpolls/issues/17",
  "decision": "https://github.com/ahemberg/swedishpolls/issues/8#issuecomment-5575724091",
  "note": "Example payloads show the frozen shape with illustrative numbers. They are not a published estimate; public publication is https://github.com/ahemberg/swedishpolls/issues/21.",
  "rules": {
    "dateBounds": "inclusive",
    "displaySteps": [1, 3, 7],
    "stepRule": "A bounded positive step samples the supported range and always retains the last requested supported date. Sampling never refits the model.",
    "missingValue": "null",
    "missingValueRule": "An unsupported or unreported value is null. It is never zero and never filled.",
    "currentMaxAgeSeconds": 300,
    "immutableMaxAgeSeconds": 31536000,
    "etag": "A content-based ETag covers the response body, so query, schema and translation differences produce different validators.",
    "pinning": "Every dependent request carries the publication resolved once for the page. A permanent publication link never falls back to the current publication.",
    "languages": ["sv", "en"]
  },
  "surfaces": [
    {
      "id": "publication",
      "method": "GET",
      "path": "/api/v1/publication",
      "permanentPath": "/api/v1/publications/{publicationId}",
      "mediaType": "application/json",
      "cache": "current",
      "permanentCache": "immutable",
      "paging": false,
      "example": "examples/publication.json",
      "query": [],
      "errors": ["unknown_publication", "estimates_unavailable"]
    },
    {
      "id": "estimates-latest",
      "method": "GET",
      "path": "/api/v1/estimates/latest",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/estimates-latest.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "coveragePeriod", "type": "coverage-period-id", "required": false, "default": "the period covering the estimate date"}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "estimates-history",
      "method": "GET",
      "path": "/api/v1/estimates/history",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/estimates-history.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "from", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "to", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "step", "type": "integer", "required": false, "allowed": [1, 3, 7], "default": 1},
        {"name": "coveragePeriod", "type": "coverage-period-id", "required": false}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "polls",
      "method": "GET",
      "path": "/api/v1/polls",
      "mediaType": "application/json",
      "cache": "current",
      "paging": true,
      "example": "examples/polls.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "from", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "to", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "institute", "type": "string-list", "required": false},
        {"name": "party", "type": "component-list", "required": false},
        {"name": "coveragePeriod", "type": "coverage-period-id", "required": false},
        {"name": "includeExcluded", "type": "boolean", "required": false, "default": false}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "polls-csv",
      "method": "GET",
      "path": "/api/v1/polls.csv",
      "mediaType": "text/csv; charset=utf-8",
      "cache": "current",
      "paging": false,
      "example": "examples/polls.csv",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "from", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "to", "type": "date", "required": false, "bounds": "inclusive"},
        {"name": "institute", "type": "string-list", "required": false},
        {"name": "party", "type": "component-list", "required": false},
        {"name": "coveragePeriod", "type": "coverage-period-id", "required": false},
        {"name": "includeExcluded", "type": "boolean", "required": false, "default": false}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "institutes",
      "method": "GET",
      "path": "/api/v1/institutes",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/institutes.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "electionCycle", "type": "string", "required": false, "default": "the current cycle"}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "elections",
      "method": "GET",
      "path": "/api/v1/elections",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/elections.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "coveragePeriod", "type": "coverage-period-id", "required": false, "note": "Selects the grouping an election reference is compared with."}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "seats",
      "method": "GET",
      "path": "/api/v1/seats",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/seats.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "election", "type": "integer", "required": false, "note": "The election year being approximated; it selects the era allocation rule."}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    },
    {
      "id": "coalitions",
      "method": "GET",
      "path": "/api/v1/coalitions",
      "mediaType": "application/json",
      "cache": "current",
      "paging": false,
      "example": "examples/coalitions.json",
      "query": [
        {"name": "publication", "type": "publication-id", "required": false, "default": "current"},
        {"name": "election", "type": "integer", "required": false},
        {"name": "coalition", "type": "coalition-id-list", "required": false, "note": "Restricted to the ten approved memberships."}
      ],
      "errors": ["invalid_filter", "estimates_unavailable"]
    }
  ],
  "errors": [
    {"code": "unknown_version", "status": 404, "when": "A path outside /api/v1."},
    {"code": "unknown_route", "status": 404, "when": "An unknown resource inside the version."},
    {"code": "unknown_publication", "status": 404, "when": "A permanent publication link that does not exist. It never falls back to the current publication."},
    {"code": "invalid_filter", "status": 400, "when": "An unparseable or out-of-range query value, including an unsupported display step."},
    {"code": "estimates_unavailable", "status": 503, "when": "A request requiring a publication before the first one exists.", "example": "examples/errors.json"}
  ]
}
